{
  "name": "daily-quizine",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:voo": "vite --config vite.config.voo.ts",
    "dev:it": "vite --config vite.config.it.ts",
    "dev:blaljus": "vite --config vite.config.blaljus.ts",
    "dev:handel": "vite --config vite.config.handel.ts",
    "build:quizine": "tsc -b && vite build",
    "build:voo": "vite build --config vite.config.voo.ts",
    "build:it": "vite build --config vite.config.it.ts",
    "build:blaljus": "vite build --config vite.config.blaljus.ts",
    "build:handel": "vite build --config vite.config.handel.ts",
    "build": "npm run build:quizine && npm run build:voo && npm run build:it && npm run build:blaljus && npm run build:handel",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
